---
import '../styles/global.css';
import { whatsappUrl } from '../data/site';

const {
	title = 'JW Jabonería Artesanal — Jabones Naturales Hechos a Mano',
	description = 'JW Jabonería Artesanal — Jabones artesanales naturales elaborados a mano en pequeños lotes. Saponificación en frío, ingredientes puros y un cuidado premium para tu piel.',
} = Astro.props;
---

<!doctype html>
<html lang="es" class="lenis">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/x-icon" href="/jww.ico" />
		<link rel="icon" href="/jww.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content={description}
		/>
		<meta
			name="keywords"
			content="jabones artesanales, jabones naturales, jabones corporales, saponificación en frío, cuidado natural de la piel, cosmética artesanal"
		/>
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Jost:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap&text=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789&,.!?%$+*:;()[]-–"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div
			id="page-transition"
			class="pointer-events-none fixed inset-0 z-[999] bg-[#f2e8d9]"
			style="opacity: 1"
			aria-hidden="true"
		></div>
		<slot />
		<script>
			import Lenis from 'lenis';
			import { gsap } from 'gsap';
			import { ScrollTrigger } from 'gsap/ScrollTrigger';

			gsap.registerPlugin(ScrollTrigger);

			const lenis = new Lenis({
				duration: 1.2,
				easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
				smoothWheel: true,
			});

			lenis.on('scroll', ScrollTrigger.update);

			gsap.ticker.add((time) => {
				lenis.raf(time * 1000);
			});
			gsap.ticker.lagSmoothing(0);

			const overlay = document.getElementById('page-transition');
			const HEADER_OFFSET = -90;

			const scrollToHash = (hash) => {
				if (!hash || hash === '#') {
					lenis.scrollTo(0, { duration: 1.2 });
					return;
				}
				const target = document.querySelector(hash);
				if (target) {
					lenis.scrollTo(target, { offset: HEADER_OFFSET, duration: 1.3 });
				}
			};

			// Entrada con fundido
			if (overlay) {
				overlay.style.pointerEvents = 'auto';
				gsap.to(overlay, {
					opacity: 0,
					duration: 0.55,
					ease: 'power2.out',
					onComplete: () => {
						overlay.style.pointerEvents = 'none';
						ScrollTrigger.refresh();
					},
				});

				if (window.location.hash) {
					setTimeout(() => scrollToHash(window.location.hash), 580);
				}
			}

			// Navegación interna con transición suave
			document.addEventListener('click', (event) => {
				const anchor = event.target.closest('a');
				if (!anchor) return;

				const href = anchor.getAttribute('href') || '';
				if (!href) return;

				if (href === '#') {
					event.preventDefault();
					lenis.scrollTo(0, { duration: 1.2 });
					return;
				}

				let targetUrl;
				try {
					targetUrl = new URL(href, window.location.origin);
				} catch {
					return;
				}

				if (targetUrl.origin !== window.location.origin) return;
				if (anchor.target === '_blank') return;

				if (targetUrl.pathname === window.location.pathname) {
					if (targetUrl.hash) {
						event.preventDefault();
						scrollToHash(targetUrl.hash);
					}
					return;
				}

				event.preventDefault();
				if (window.__pageTransitioning) return;
				window.__pageTransitioning = true;

				if (overlay) {
					overlay.style.pointerEvents = 'auto';
					gsap.to(overlay, {
						opacity: 1,
						duration: 0.35,
						ease: 'power2.in',
						onComplete: () => {
							window.location.assign(targetUrl.pathname + targetUrl.search + targetUrl.hash);
						},
					});
				} else {
					window.location.assign(targetUrl.pathname + targetUrl.search + targetUrl.hash);
				}
			});

			setTimeout(() => {
				ScrollTrigger.refresh();
			}, 200);
		</script>

		<!-- Botón flotante de WhatsApp -->
		<a
			href={whatsappUrl()}
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Chatea por WhatsApp para hacer tu pedido"
			class="fixed bottom-6 right-6 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] shadow-lg transition-transform duration-300 hover:scale-110 sm:bottom-8 sm:right-8"
		>
			<svg viewBox="0 0 24 24" fill="#ffffff" width="26" height="26" aria-hidden="true">
				<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
			</svg>
		</a>
	</body>
</html>
