---
/**
 * Kits & Packs — combinaciones y paquetes (dentro de la sección Catálogo,
 * alternados con los jabones individuales vía tabs "Individuales / Kits").
 */
import { Image } from 'astro:assets';
import { kits, buildKitSoaps } from '../data/kits';
import { whatsappUrl } from '../data/site';
---

<div data-kits-panel role="tabpanel" id="kits-panel" aria-labelledby="tab-kits">
	<!-- Grid asimétrico: destacado (2/3) + estándar (1/3) -->
	<div class="grid grid-cols-1 gap-6 md:grid-cols-3">
		{
			kits.map((kit, ki) => (
				<article
					data-kit-card
					data-tipo={kit.tipo}
					class={`group flex flex-col overflow-hidden rounded-4xl border border-pine-teal/10 bg-ecru shadow-soft transition-all duration-300 hover:-translate-y-1.5 hover:shadow-lift ${
						kit.tipo === 'destacado' ? 'md:col-span-2' : ''
					}`}
				>
					<div
						style={{ backgroundColor: kit.tone }}
						class={`relative overflow-hidden ${kit.tipo === 'destacado' ? 'aspect-[3/4] md:aspect-[16/9]' : 'aspect-[3/4]'}`}
					>
						<Image
							src={kit.image}
							alt={kit.name}
							width={kit.tipo === 'destacado' ? 1200 : 640}
							formats={['webp', 'avif']}
							quality={72}
							loading="lazy"
							decoding="async"
							class={`absolute inset-0 h-full w-full object-cover object-center ${
								kit.tipo === 'destacado'
									? ''
									: 'scale-105 transition-transform duration-700 group-hover:scale-110'
							}`}
						/>
						{kit.tag && (
							<span class="absolute left-4 top-4 rounded-full border border-white/40 bg-white/15 px-3 py-1 text-[10px] font-medium uppercase tracking-widest2 text-white backdrop-blur-sm">
								{kit.tag}
							</span>
						)}
						{kit.ahorro > 0 && (
							<span class="absolute right-4 top-4 rounded-full bg-terracotta px-3 py-1 text-[11px] font-semibold text-white shadow-glow">
								Ahorras S/ {kit.ahorro}.00
							</span>
						)}
						<div
							class="pointer-events-none absolute inset-0 bg-gradient-to-tr from-pine-teal/70 via-pine-teal/25 to-transparent opacity-90"
							aria-hidden="true"
						/>
					</div>

					<div class="flex flex-1 flex-col p-5">
						<p class="text-[11px] font-medium uppercase tracking-widest3 text-hunter-green-600">
							{kit.format}
						</p>
						<h3 class="mt-2 font-serif text-xl font-medium leading-snug text-pine-teal-200">
							{kit.name}
						</h3>
						<p class="mt-2 text-sm leading-relaxed text-pine-teal-400">{kit.tagline}</p>
						{kit.benefits && (
							<ul class="mt-3 flex flex-wrap gap-2">
								{kit.benefits.map((b) => (
									<li class="rounded-full bg-hunter-green-900/6 px-2.5 py-1 text-[10px] font-medium uppercase tracking-widest2 text-pine-teal-400">
										{b}
									</li>
								))}
							</ul>
						)}

						<p class="mt-4 flex items-baseline gap-3">
							<span class="font-serif text-lg text-pine-teal-400 line-through">
								S/ {kit.precioOriginal}.00
							</span>
							<span class="font-serif text-3xl font-medium text-pine-teal-200">
								S/ {kit.precioKit}.00
							</span>
						</p>

						<div class="mt-auto flex flex-col gap-2 pt-5">
							<a
								data-magnetic
								href={whatsappUrl(
									`Hola, quiero comprar ${kit.name} (S/ ${kit.precioKit}.00). ¿Cómo hago mi pedido?`,
								)}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-terracotta px-4 py-3 text-[11px] font-semibold uppercase tracking-widest2 text-white shadow-glow transition-all duration-300 hover:bg-terracotta-600"
							>
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l-1.2 12H6.2L5 8Z" /><path d="M9 8V6a3 3 0 0 1 6 0v2" /></svg>
								Comprar
							</a>
<a
							href="/#guia"
							class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-pine-teal/20 px-4 py-3 text-[11px] font-medium uppercase tracking-widest2 text-pine-teal-300 transition-all duration-300 hover:border-terracotta hover:bg-terracotta hover:text-white"
						>
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v5m0-8.5v.5" /></svg>
							Más información
						</a>
						</div>
					</div>
				</article>
			))
		}
	</div>

	<!-- Fila 3: Arma tu Kit (interactiva) -->
	<section
		class="mt-6 overflow-hidden rounded-4xl border border-pine-teal/10 bg-ecru shadow-soft"
		aria-labelledby="arma-tu-kit-title"
	>
		<div class="grid grid-cols-1 gap-6 p-6 lg:grid-cols-2 lg:p-8">
			<div>
				<span class="eyebrow inline-flex items-center gap-3">
					<span class="h-px w-8 bg-hunter-green-600"></span>
					Personalizado
					<span class="h-px w-8 bg-hunter-green-600"></span>
				</span>
				<h3 id="arma-tu-kit-title" class="mt-4 font-serif text-3xl font-medium sm:text-4xl">
					Arma tu <span class="italic text-hunter-green-600">Kit</span>
				</h3>
				<p class="mt-4 text-base leading-relaxed text-pine-teal-400">
					Elige 3 jabones a elección. Tu precio se recalcula automáticamente con descuento por paquete.
				</p>

				<div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3" data-kit-options role="group" aria-label="Elige 3 jabones">
					{buildKitSoaps.map((soap) => (
						<button
							type="button"
							data-soap={soap.slug}
							data-name={soap.name}
							aria-pressed="false"
							class="flex items-center gap-3 rounded-2xl border border-pine-teal/15 bg-white/60 p-3 text-left transition-all duration-300 hover:border-terracotta focus:outline-none focus-visible:ring-2 focus-visible:ring-terracotta"
						>
							<span
								class="h-8 w-8 shrink-0 rounded-lg border border-white/70"
								style={{ backgroundColor: soap.tone }}
								aria-hidden="true"
							></span>
							<span class="min-w-0 text-xs font-medium leading-tight text-pine-teal-300">{soap.name}</span>
						</button>
					))}
				</div>
			</div>

			<div class="flex flex-col justify-between rounded-3xl border border-pine-teal/10 bg-ecru/70 p-6">
				<div>
					<p class="text-[11px] font-medium uppercase tracking-widest3 text-hunter-green-600">
						Tu selección
					</p>
					<ul data-kit-basket class="mt-4 flex flex-col gap-2" aria-live="polite">
						<li data-basket-empty class="text-sm text-pine-teal-400 italic">
							Aún no has elegido jabones…
						</li>
					</ul>
				</div>

				<div class="mt-6 flex flex-wrap items-end justify-between gap-x-4 gap-y-3 border-t border-pine-teal/10 pt-5">
					<div>
						<p class="text-[11px] font-medium uppercase tracking-widest3 text-pine-teal-400">
							Total estimado
						</p>
						<p class="mt-1 flex items-baseline gap-3">
							<span data-kit-original class="font-serif text-lg text-pine-teal-400 line-through">S/ 30.00</span>
							<span data-kit-total class="font-serif text-3xl font-medium text-pine-teal-200">S/ 0.00</span>
						</p>
					</div>
					<p data-kit-save class="rounded-full bg-terracotta px-3 py-1 text-[11px] font-semibold text-white opacity-0 transition-opacity duration-300">
						Ahorras S/ 0
					</p>
				</div>

				<button
					data-kit-buy
					type="button"
					disabled
					class="mt-5 inline-flex w-full cursor-not-allowed items-center justify-center gap-2 rounded-full bg-terracotta/40 px-4 py-3 text-[11px] font-semibold uppercase tracking-widest2 text-white/80 transition-all duration-300"
				>
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l-1.2 12H6.2L5 8Z" /><path d="M9 8V6a3 3 0 0 1 6 0v2" /></svg>
					<span data-kit-buy-label>Elige 3 jabones</span>
				</button>
			</div>
		</div>
	</section>
</div>
