---
/**
 * ValueProposition — tres valores premium que definen la experiencia JW.
 */
const values = [
	{
		title: 'Glicerina Natural Conservada',
		desc: 'Retenemos el 100% de los agentes humectantes que el jabón industrial descarta, para una limpieza que hidrata en lugar de resecar.',
		icon: 'drop',
		tone: 'bg-dry-sage-800',
	},
	{
		title: 'Curado de 4 a 6 Semanas',
		desc: 'Cada lote reposa paciente hasta lograr una barra suave, duradera y con un pH equilibrado que respeta tu piel.',
		icon: 'clock',
		tone: 'bg-fern-800',
	},
	{
		title: 'Botánica Pura y Sostenible',
		desc: 'Aceites vírgenes, mantecas, arcillas y extractos florales, con empaques reciclables y libres de plástico.',
		icon: 'leaf',
		tone: 'bg-pine-teal-800',
	},
];
---

<section class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
	<div class="mx-auto max-w-2xl text-center">
		<span class="eyebrow inline-flex items-center gap-3">
			<span class="h-px w-8 bg-hunter-green-600"></span>
			Por qué JW
			<span class="h-px w-8 bg-hunter-green-600"></span>
		</span>
		<h2 class="mt-4 font-serif text-4xl font-medium sm:text-5xl">
			El Cuidado Premium que tu Piel <span class="italic text-hunter-green-600">Merece</span>
		</h2>
		<p class="mt-4 text-base leading-relaxed text-pine-teal-400">
			Cada producto es resultado de un proceso artesanal lento y cuidadoso. Así garantizamos
			calidad, pureza y una experiencia sensorial inolvidable.
		</p>
	</div>

	<div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
		{values.map((value) => (
			<div
				data-reveal-grid
				class="group relative overflow-hidden rounded-4xl border border-pine-teal/10 bg-ecru p-9 shadow-soft transition-all duration-300 hover:-translate-y-1.5 hover:shadow-lift"
			>
				<div
					class="pointer-events-none absolute -right-10 -top-10 h-32 w-32 rounded-full bg-hunter-green-900 blur-2xl opacity-40 transition-opacity group-hover:opacity-70"
					aria-hidden="true"
				></div>
				<div class="relative">
					<div class={['flex h-14 w-14 items-center justify-center rounded-2xl text-white shadow-sm', value.tone].join(' ')}>
						{value.icon === 'drop' && (
							<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c-3 4.5-6 8.2-6 11.5a6 6 0 0 0 12 0c0-3.3-3-7-6-11.5Z" /></svg>
						)}
						{value.icon === 'clock' && (
							<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
						)}
						{value.icon === 'leaf' && (
							<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21C12 8 17 3 21 3c0 11-4 18-9 18Zm0 0c0-8-5-11-9-11" /></svg>
						)}
					</div>
					<h3 class="mt-6 font-serif text-2xl font-medium leading-snug text-pine-teal-200">{value.title}</h3>
					<p class="mt-3 text-sm leading-relaxed text-pine-teal-400">{value.desc}</p>
				</div>
			</div>
		))}
	</div>
</section>
