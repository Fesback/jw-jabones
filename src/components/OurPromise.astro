---
/**
 * OurPromise — compromisos de marca en banda tierra con iconos.
 */
const promises = [
	{ label: 'Cruelty Free', icon: 'heart' },
	{ label: 'Vegano', icon: 'leaf' },
	{ label: 'Sin Parabenos', icon: 'ban' },
	{ label: 'Sin Sulfatos', icon: 'drop' },
	{ label: 'Empaque Reciclable', icon: 'box' },
];
---

<section class="mx-auto max-w-7xl px-4 pb-20 sm:px-6 lg:px-8">
	<div class="rounded-5xl bg-gradient-to-r from-dust-grey-800 via-dust-grey-700 to-dry-sage-900 px-4 py-14 shadow-soft sm:px-10">
		<div class="mx-auto grid max-w-6xl grid-cols-2 gap-8 md:grid-cols-3 lg:grid-cols-5">
			{promises.map((p) => (
				<div class="group flex flex-col items-center gap-4 text-center">
					<span
						class="flex h-16 w-16 items-center justify-center rounded-full border border-pine-teal/10 bg-ecru text-hunter-green-600 shadow-soft transition-transform duration-300 group-hover:scale-110"
					>
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							{p.icon === 'heart' && <path d="M12 21C8 17 4 13.5 4 9.5A4.5 4.5 0 0 1 12 7a4.5 4.5 0 0 1 8 2.5c0 4-4 7.5-8 11.5Z" />}
							{p.icon === 'leaf' && <path d="M12 21C12 8 17 3 21 3c0 11-4 18-9 18Zm0 0c0-8-5-11-9-11" />}
							{p.icon === 'ban' && <circle cx="12" cy="12" r="9" /><path d="m5.5 5.5 13 13" />}
							{p.icon === 'drop' && <path d="M12 3c-3 4.5-6 8.2-6 11.5a6 6 0 0 0 12 0c0-3.3-3-7-6-11.5Z" />}
							{p.icon === 'box' && <path d="M4 9l8-5 8 5v11l-8 5-8-5V9Z" /><path d="m4 9 8 5 8-5M12 14v10" />}
						</svg>
					</span>
					<span class="text-[11px] font-medium uppercase tracking-widest2 text-pine-teal-400">
						{p.label}
					</span>
				</div>
			))}
		</div>
	</div>
</section>
