---
/**
 * Footer — tierra premium con marca, enlaces, contacto (id #contacto) + copyright.
 */
import jwLogo from '../assets/jw-logo-re.png';
import { whatsappUrl } from '../data/site';

const helpItems = [
	'Envíos y Entrega',
	'Devoluciones',
	'Preguntas Frecuentes',
	'Términos de Servicio',
	'Política de Privacidad',
];

const socials = [
	{ label: 'Instagram', href: 'https://www.instagram.com/', d: 'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4Zm5 5.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7ZM17 6.5a1 1 0 1 0 0 2 1 1 0 0 0 0-2Z' },
	{ label: 'TikTok', href: 'https://www.tiktok.com/', d: 'M14 4v9a3.5 3.5 0 1 1-3.5-3.5M14 4c.2 2.3 1.6 3.7 4 4' },
];
---

<footer id="contacto" class="relative mt-8 border-t border-pine-teal/10 bg-gradient-to-b from-dust-grey-900 to-dust-grey-800 pt-16">
	<div
		class="pointer-events-none absolute inset-0 -z-10 overflow-hidden"
		aria-hidden="true"
	>
		<div class="absolute -left-20 bottom-0 h-72 w-72 rounded-full bg-dry-sage/30 blur-3xl"></div>
		<div class="absolute -right-20 top-10 h-72 w-72 rounded-full bg-hunter-green/10 blur-3xl"></div>
	</div>

	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
			<!-- Brand -->
			<div>
				<a href="/#inicio" class="inline-flex items-center">
					<img src={jwLogo.src} alt="JW Jabonería Artesanal" class="h-14 w-auto" />
				</a>
				<p class="mt-5 max-w-xs text-sm leading-relaxed text-pine-teal-400">
					Jabones artesanales naturales elaborados a mano en pequeños lotes. Saponificación en
					frío, ingredientes puros y un cuidado premium y consciente para tu piel y el planeta.
				</p>
				<div class="mt-6 flex gap-3">
					{socials.map((s) => (
						<a
							href={s.href}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={s.label}
							class="flex h-10 w-10 items-center justify-center rounded-full border border-pine-teal/20 text-pine-teal-300 transition-all duration-300 hover:border-terracotta hover:bg-terracotta hover:text-white"
						>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d={s.d} /></svg>
						</a>
					))}
				</div>
			</div>

			<!-- Enlaces -->
			<div>
				<h4 class="font-sans text-xs font-semibold uppercase tracking-widest2 text-pine-teal-200">Explorar</h4>
				<ul class="mt-5 space-y-3 text-sm text-pine-teal-400">
					{['Inicio', 'Catálogo', 'Guía del Cuidado', 'Nuestro Proceso', 'Sobre Nosotros'].map((l) => (
						<li><a href={`/#${['inicio', 'catalogo', 'guia', 'proceso', 'nosotros'][['Inicio', 'Catálogo', 'Guía del Cuidado', 'Nuestro Proceso', 'Sobre Nosotros'].indexOf(l)]}`} class="transition-colors hover:text-hunter-green-600">{l}</a></li>
					))}
				</ul>
			</div>

			<!-- Atención al cliente -->
			<div>
				<h4 class="font-sans text-xs font-semibold uppercase tracking-widest2 text-pine-teal-200">Ayuda</h4>
				<ul class="mt-5 space-y-3 text-sm text-pine-teal-400">
					{helpItems.map((l) => (
						<li>
							<a
								href={whatsappUrl(`Hola, tengo una consulta sobre: ${l}`)}
								target="_blank"
								rel="noopener noreferrer"
								class="transition-colors hover:text-hunter-green-600"
							>
								{l}
							</a>
						</li>
					))}
				</ul>
			</div>

			<!-- Contacto -->
			<div>
				<h4 class="font-sans text-xs font-semibold uppercase tracking-widest2 text-pine-teal-200">Contacto</h4>
				<ul class="mt-5 space-y-3 text-sm text-pine-teal-400">
					<li class="flex items-start gap-2.5">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mt-0.5 shrink-0 text-hunter-green-600"><path d="M4 5h16l-8 7L4 5Z" /><path d="M4 5v14a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V5" /></svg>
						hola@jwsaboneria.com
					</li>
					<li class="flex items-start gap-2.5">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mt-0.5 shrink-0 text-hunter-green-600"><path d="M5 4h4l1.5 4L8 9.5a10 10 0 0 0 6.5 6.5L16.5 14l4 1.5v4a1.7 1.7 0 0 1-1.8 1.7C11 21 3 13 3 6a1.7 1.7 0 0 1 2-2Z" /></svg>
						+1 (800) 555-0147
					</li>
					<li class="flex items-start gap-2.5">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mt-0.5 shrink-0 text-hunter-green-600"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
						Lun–Vie, 9am–6pm
					</li>
				</ul>
			</div>
		</div>
	</div>

	<div class="mt-14 border-t border-pine-teal/10">
		<div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-3 px-4 py-6 text-xs text-pine-teal-400 sm:flex-row sm:px-6 lg:px-8">
			<p>&copy; {new Date().getFullYear()} JW Jabonería Artesanal. Todos los derechos reservados.</p>
			<p class="uppercase tracking-widest2">Jabón real, hecho a mano</p>
		</div>
	</div>
</footer>
