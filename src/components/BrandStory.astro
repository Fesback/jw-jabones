---
/**
 * BrandStory — Sobre Nosotros (id #nosotros), storytelling & craftsmanship.
 */
import banImage from '../assets/ban.jpeg';

const trust = [
	{ label: 'Saponificado en Frío', icon: 'snow' },
	{ label: 'Pequeños Lotes', icon: 'heart' },
	{ label: 'Cero Químicos', icon: 'leaf' },
];
---

<section id="nosotros" class="relative mx-auto max-w-7xl scroll-mt-24 px-4 py-16 sm:px-6 lg:px-8">
	<div data-reveal class="grid grid-cols-1 overflow-hidden rounded-5xl border border-pine-teal/10 bg-gradient-to-br from-[#ede3d0] via-[#f2e8d9] to-[#ddd2c0] shadow-soft lg:grid-cols-2">
		<!-- Copy -->
		<div class="flex flex-col justify-center p-8 sm:p-14 lg:p-16">
			<span class="eyebrow">Sobre Nosotros</span>
			<h2 class="mt-4 font-serif text-4xl font-medium leading-tight sm:text-5xl">
				El Arte de <span class="italic text-hunter-green-600">JW</span>, Hecho con Paciencia y Amor
			</h2>
			<p class="mt-5 max-w-md text-base leading-relaxed text-pine-teal-400">
				JW nace de la pasión por lo auténtico. Creemos que la belleza no debería costarle a tu
				piel ni al planeta, por eso elaboramos cada jabón en pequeños lotes artesanales,
				respetando los tiempos que la naturaleza necesita.
			</p>
			<div class="mt-8">
				<a href="/#proceso" class="btn-primary">Conoce Nuestro Proceso</a>
			</div>
			<!-- Trust -->
			<div class="mt-12 flex flex-wrap gap-8 border-t border-pine-teal/10 pt-8">
				{trust.map((item) => (
					<div class="flex items-center gap-2.5">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4a5a3a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							{item.icon === 'snow' && <path d="M12 2v20M4 6l16 12M20 6 4 18M12 6l6-4M12 6 6 2M12 18l6 4m-6-4-6 4" />}
							{item.icon === 'heart' && <path d="M12 21C8 17 4 13.5 4 9.5A4.5 4.5 0 0 1 12 7a4.5 4.5 0 0 1 8 2.5c0 4-4 7.5-8 11.5Z" />}
							{item.icon === 'leaf' && <path d="M12 21C12 8 17 3 21 3c0 11-4 18-9 18Zm0 0c0-8-5-11-9-11" />}
						</svg>
						<span class="text-[12px] font-medium uppercase tracking-[0.12em] text-pine-teal-400">
							{item.label}
						</span>
					</div>
				))}
			</div>
		</div>

		<!-- Visual -->
		<div class="relative min-h-[16rem] overflow-hidden sm:min-h-[22rem]">
			<img
				src={banImage.src}
				alt="Jabones artesanales JW en el taller"
				loading="lazy"
				class="absolute inset-0 h-full w-full object-cover object-center"
			/>
			<span
				class="absolute bottom-6 right-8 font-serif text-lg italic text-white/95"
				style="text-shadow: 0 1px 8px rgba(15, 30, 22, 0.45)"
			>
				Jabón real, hecho a mano
			</span>
		</div>
	</div>
</section>
