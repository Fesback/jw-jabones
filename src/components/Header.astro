---
/**
 * Header — logo JW, navegación centrada y acciones a la derecha.
 * Incluye menú móvil con toggle accesible.
 */
import jwwLogo from '../assets/jww.png';

const navItems = [
	{ label: 'Inicio', href: '/#inicio' },
	{ label: 'Catálogo', href: '/#catalogo' },
	{ label: 'Nuestro Proceso', href: '/#proceso' },
	{ label: 'Sobre Nosotros', href: '/#nosotros' },
	{ label: 'Contacto', href: '/#contacto' },
];
---

<header class="sticky top-0 z-50 border-b border-pine-teal/10 bg-dust-grey-900/85 backdrop-blur-md">
	<div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3.5 sm:px-6 lg:px-8">
		<!-- Logo -->
		<a href="/#inicio" class="flex shrink-0 items-center">
			<img src={jwwLogo.src} alt="JW Jabonería Artesanal" class="h-11 w-auto sm:h-12" />
		</a>

		<!-- Nav (desktop) -->
		<nav class="hidden items-center gap-8 lg:flex">
			{navItems.map((item) => (
				<a
					href={item.href}
					class="text-[12px] font-medium tracking-[0.14em] text-pine-teal-300 transition-colors hover:text-hunter-green-600"
				>
					{item.label}
				</a>
			))}
		</nav>

		<!-- Actions -->
		<div class="flex shrink-0 items-center gap-3 text-pine-teal-300">
			<a href="/#catalogo" class="btn-primary hidden !px-6 !py-3 sm:inline-flex">
				Comprar
			</a>
			<button
				id="menu-toggle"
				aria-label="Abrir menú"
				aria-expanded="false"
				class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-pine-teal/20 text-pine-teal-300 transition-colors hover:bg-white lg:hidden"
			>
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
					<path d="M4 7h16M4 12h16M4 17h16" />
				</svg>
			</button>
		</div>
	</div>

	<!-- Menú móvil -->
	<div id="mobile-menu" class="hidden border-t border-pine-teal/10 bg-dust-grey-900 px-4 py-4 lg:hidden">
		<nav class="flex flex-col gap-2">
			{navItems.map((item) => (
				<a
					href={item.href}
					class="rounded-xl px-4 py-3 text-sm font-medium tracking-wide text-pine-teal-300 transition-colors hover:bg-white hover:text-hunter-green-600"
				>
					{item.label}
				</a>
			))}
		</nav>
	</div>
</header>

<script>
	const toggle = document.getElementById('menu-toggle');
	const menu = document.getElementById('mobile-menu');
	if (toggle && menu) {
		toggle.addEventListener('click', () => {
			const open = menu.classList.toggle('hidden');
			toggle.setAttribute('aria-expanded', String(!open));
		});
		menu.querySelectorAll('a').forEach((a) =>
			a.addEventListener('click', () => menu.classList.add('hidden'))
		);
	}
</script>
